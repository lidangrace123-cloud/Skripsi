# ============================================
# PAYROLL WHATSAPP APP - Environment Variables
# ============================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.
# JANGAN pernah commit file .env ke repository publik.

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Secret - Ganti dengan string acak yang panjang dan aman!
SESSION_SECRET=ganti_dengan_string_rahasia_yang_sangat_panjang_dan_acak

# Fonnte API Token
# Dapatkan token dari https://fonnte.com/
FONNTE_TOKEN=ISI_TOKEN_FONNTE_ANDA_DI_SINI

# Application Base URL
# Gunakan URL HTTPS yang dapat diakses publik (bukan localhost) agar tautan PDF bisa dibuka via WhatsApp.
# Contoh: https://yourdomain.com atau https://xxxx.ngrok.io
APP_BASE_URL=http://localhost:3000

# PDF Token Expiry (dalam detik, default: 7 hari)
PDF_TOKEN_EXPIRY=604800

# Upload delay antar pengiriman WhatsApp (dalam milidetik, default: 2 detik)
SEND_DELAY_MS=2000

# Max file size untuk upload PDF (dalam bytes, default: 10MB)
MAX_FILE_SIZE=10485760
